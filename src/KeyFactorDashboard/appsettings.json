{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:43123",
  "Python": {
    "BaseUrl": "http://127.0.0.1:8001",
    "AutoStart": true,
    "Port": 8001
  },
  "Api": {
    "Key": "",
    "EnableSwagger": true
  },
  "Auth": {
    "Issuer": "KeyFactor",
    "Audience": "KeyFactor",
    "SigningKey": "plant-edition-dev-signing-key-32b!",
    "LifetimeHours": 12
  },
  "Cors": {
    "Origins": [ "http://127.0.0.1:5174", "http://localhost:5174", "http://127.0.0.1:43123" ]
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/keyfactor.db"
  }
}
